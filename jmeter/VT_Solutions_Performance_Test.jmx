          <hashTree/>
          <JSONPathAssertion guiclass="JSONPathAssertionGui" testclass="JSONPathAssertion" testname="Validacion JSON - Login Exitoso">
            <stringProp name="JSON_PATH">$.ok</stringProp>
            <stringProp name="EXPECTED_VALUE">true</stringProp>
            <boolProp name="JSONVALIDATION">true</boolProp>
            <boolProp name="EXPECT_NULL">false</boolProp>
            <boolProp name="INVERT">false</boolProp>
            <boolProp name="ISREGEX">false</boolProp>
          </JSONPathAssertion>
          <hashTree/>
          <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="Extractor JSON - ID Usuario Login">
            <stringProp name="JSONPostProcessor.referenceNames">LOGIN_USER_ID</stringProp>
            <stringProp name="JSONPostProcessor.jsonPathExprs">$.data.id</stringProp>
            <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
            <stringProp name="JSONPostProcessor.defaultValues">NOT_FOUND</stringProp>
          </JSONPostProcessor>
          <hashTree/>
        </hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="DEBUG - Verificar ID Extraido" enabled="false">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">
def userId = vars.get(&apos;LOGIN_USER_ID&apos;)

if (!userId || userId == &apos;NOT_FOUND&apos;) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseMessage(&apos;No se pudo extraer el ID&apos;)
} else {
    SampleResult.setSuccessful(true)
    SampleResult.setResponseMessage(&apos;ID extraido correctamente&apos;)
}
</stringProp>
        </JSR223Sampler>
